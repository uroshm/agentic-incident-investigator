# Default application mode. Set to ollama after starting a local model.
INVESTIGATION_MODE=rules
LLM_MODEL=llama3.1:8b

# Recommended on macOS: Ollama running on the host.
LLM_BASE_URL=http://host.docker.internal:11434

# For the optional Docker Ollama profile, set:
# LLM_BASE_URL=http://ollama:11434
